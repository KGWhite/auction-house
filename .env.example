# Copy to .env and adjust (docker compose reads it automatically).
# Every value below is the default used when the variable is not set.

# PostgreSQL (the container and the connection string both derive from these)
POSTGRES_USER=auction
POSTGRES_PASSWORD=auction
POSTGRES_DB=auction

# Published ports on the host
WEB_PORT=5173
API_PORT=8080
POSTGRES_PORT=5432

APP_ENV=dev

# Bidding
BID_INCREMENT_PERCENT=5
BID_INCREMENT_MIN=10

# Time bands (remaining time thresholds)
BAND_VERY_SHORT=2m
BAND_SHORT=5m
BAND_MEDIUM=10m
BAND_LONG=20m

# Random auction duration range
AUCTION_MIN_DURATION=3m
AUCTION_MAX_DURATION=25m

# Settlement worker
SETTLE_INTERVAL=2s
SETTLE_BATCH_SIZE=50

# Refresh worker
REFRESH_INTERVAL=5m
ITEMS_PER_BRACKET=8
BRACKET_MIN=0
BRACKET_MAX=5
